{
  "name": "agent-gateway",
  "version": "0.1.1",
  "description": "Local agent HTTP gateway (NestJS)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/public && cp -a public dist/public && chmod +x dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "pack:bin": "node scripts/pack-bin.mjs"
  },
  "dependencies": {
    "@cursor/sdk": "^1.2.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/serve-static": "^5.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.6",
    "tar": "^7.5.22",
    "typescript": "^5.7.3"
  },
  "license": "MIT"
}